---
const { alternative, title, description, icon, href, linkText, blackIcon } = Astro.props;
---

<div class="flex items-start">
    <dt class="flex-shrink-0">
        <div
            class="flex h-22 w-28 items-center justify-center rounded-md bg-white"
        >
            <img class={`h-16 w-16${blackIcon ? ' brightness-0' : ''}`} src={icon} />
        </div>
        {
            title && (
                <p class="ml-16 text-lg font-medium leading-6 text-white">
                    {title}
                </p>
            )
        }
    </dt>
    <dd class="ml-6 text-base text-left text-white">
        {description}
    </dd>
</div>
